        <mxCell id="akbbeGpnUHGC3rCHP3Bq-20" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=51;position=0.85;base=17;position2=1;rotation=-180;" value="" vertex="1">
